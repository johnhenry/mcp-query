{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@johnhenry/mcp-query": ["../../packages/mcp-query/src/index.ts"],
      "@johnhenry/mcp-query/discovery": ["../../packages/mcp-query/src/discovery/index.ts"],
      "@johnhenry/mcp-query/server": ["../../packages/mcp-query/src/server/index.ts"],
      "@johnhenry/mcp-query-ui": ["../../packages/mcp-query-ui/src/index.ts"],
      "@johnhenry/mcp-query/devtools": ["../../packages/mcp-query/src/devtools/protocol.ts"],
      "@johnhenry/mcp-query/webmcp": ["../../packages/mcp-query/src/webmcp/index.ts"]
    }
  },
  "include": ["src", "server", "fixtures", "sandbox/server.ts", "vite.config.ts"]
}
