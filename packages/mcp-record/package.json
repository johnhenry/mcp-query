{
  "name": "@johnhenry/mcp-record",
  "version": "0.2.0",
  "description": "Record real MCP server traffic (stdio or Streamable HTTP) to a cassette and replay it offline as a deterministic mock — VCR/Polly/nock for MCP. Built on mcp-query's transport seam.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/mcp-query.git",
    "directory": "packages/mcp-record"
  },
  "homepage": "https://github.com/johnhenry/mcp-query/tree/main/packages/mcp-record",
  "bugs": "https://github.com/johnhenry/mcp-query/issues",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "record",
    "replay",
    "vcr",
    "cassette",
    "mock",
    "testing",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-record": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@johnhenry/mcp-contract": "^0.2.0",
    "@johnhenry/mcp-query": "^0.8.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
