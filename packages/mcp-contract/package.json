{
  "name": "@johnhenry/mcp-contract",
  "version": "0.1.0",
  "description": "Contract testing & breaking-change detection for MCP capability surfaces — pin a server's tools/resources/prompts, then fail CI when a live server drifts incompatibly. The dual of mcp-query codegen.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/mcp-query.git",
    "directory": "packages/mcp-contract"
  },
  "homepage": "https://github.com/johnhenry/mcp-query/tree/main/packages/mcp-contract",
  "bugs": "https://github.com/johnhenry/mcp-query/issues",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "contract-testing",
    "drift-detection",
    "breaking-changes",
    "schema-diff",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-contract": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@johnhenry/mcp-query": "^0.7.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
