{
  "name": "@johnhenry/mcp-gate",
  "version": "0.1.1",
  "description": "A config-driven MCP security/policy proxy — authorization, DLP redaction, rate-limit, circuit breaking, and audit, fronting many upstreams as one MCP endpoint. Built on mcp-query.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/mcp-query.git",
    "directory": "packages/mcp-gate"
  },
  "homepage": "https://github.com/johnhenry/mcp-query/tree/main/packages/mcp-gate",
  "bugs": "https://github.com/johnhenry/mcp-query/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-gate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/cli.ts",
    "example:01": "tsx examples/01-library-mode.ts"
  },
  "dependencies": {
    "@johnhenry/mcpq": "0.1.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
