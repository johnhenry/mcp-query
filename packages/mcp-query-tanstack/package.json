{
  "name": "@johnhenry/mcp-query-tanstack",
  "version": "0.0.0",
  "description": "TanStack Query bridge for @johnhenry/mcp-query — queryOptions/mutationOptions factories that sync mcp-query's own reactive cache into TanStack Query, including protocol push and optimistic updates, with zero extra refetches.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/mcp-query.git",
    "directory": "packages/mcp-query-tanstack"
  },
  "homepage": "https://github.com/johnhenry/mcp-query/tree/main/packages/mcp-query-tanstack",
  "bugs": "https://github.com/johnhenry/mcp-query/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@johnhenry/mcp-query": "0.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@johnhenry/mcp-query": "0.0.0",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
