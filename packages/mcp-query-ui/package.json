{
  "name": "@johnhenry/mcp-query-ui",
  "version": "0.1.0",
  "description": "MCP Apps (SEP-1865, io.modelcontextprotocol/ui) host for @johnhenry/mcp-query — mount ui:// app resources in a sandboxed iframe via the official ext-apps host helpers, with app-initiated tool calls and resource reads routed through the MCPClient (cache, interceptors, mcp-gate policy and approval apply) and app lifecycle/messages exposed as subscribable state.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/mcp-query.git",
    "directory": "packages/mcp-query-ui"
  },
  "homepage": "https://github.com/johnhenry/mcp-query/tree/main/packages/mcp-query-ui",
  "bugs": "https://github.com/johnhenry/mcp-query/issues",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3"
  },
  "peerDependencies": {
    "@johnhenry/mcp-query": ">=0.3.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@johnhenry/mcp-gate": "^0.4.2",
    "@johnhenry/mcp-query": "^0.3.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "happy-dom": "^20.10.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
